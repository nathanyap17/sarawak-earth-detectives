# Copy to .env (untracked). Names documented in docs/CREDENTIALS.md. Never commit values.
APP_ENV=local
ALLOWED_ORIGINS=http://localhost:5173
DATA_BACKEND=local
GCS_BUCKET=
# Google Cloud / Vertex AI (ADK reads these)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
MODEL_NAME=gemini-2.5-flash
MOCK_AGENTS=0
# NASA / partner data (ingest jobs only)
FIRMS_MAP_KEY=
EARTHDATA_TOKEN=
# Frontend (Vite reads VITE_* from frontend/.env.local)
# VITE_API_BASE=http://localhost:8000
# VITE_FIREBASE_API_KEY= / VITE_FIREBASE_AUTH_DOMAIN= / VITE_FIREBASE_PROJECT_ID= / VITE_FIREBASE_APP_ID=
